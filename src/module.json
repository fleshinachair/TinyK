{
  "id": "TinyK",
  "name": "TinyK",
  "abbrev": "TINYK",
  "version": "0.1",
  "description": "4-voice polyphonic virtual analog synth inspired by 2000s dual-oscillator VA engine",
  "author": "Mathew Taylor",
  "license": "MIT",
  "dsp": "dsp.so",
  "ui": "ui.js",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
