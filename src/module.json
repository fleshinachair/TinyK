              "key": "genre_category",
              "label": "Genre",
              "type": "enum",
              "options": [
                "1. Trance",
                "2. Techno/House",
                "3. Electronica",
                "4. DnB/Breaks",
                "5. Hiphop/Vintage",
                "6. Retro",
                "7. SE/Hit",
                "8. Vocoder"
              ],
              "default": 0
            },
            {
              "key": "program_num",
