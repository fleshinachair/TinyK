{
  "title": "TinyK",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "microKORG-style",
        "virtual analog synth.",
        "4 voices, or two",
        "timbres layered.",
        "",
        "128 built-in programs",
        "or your own microKORG",
        "/ MS2000 .syx banks.",
        "",
        "Jog: browse programs.",
        "Shift+Click: jump to",
        "any page."
      ]
    },
    {
      "title": "Pages",
      "children": [
        {
          "title": "1: Perf",
          "lines": [
            "Category, Program,",
            "Cutoff, Resonance,",
            "Amp Attack, Release,",
            "Timbre Edit (T1 / T2",
            "in Layer, N/A in",
            "Single), Arp on/off."
          ]
        },
        {
          "title": "2: Osc/Timbre",
          "lines": [
            "Wave 1, Wave 2,",
            "Pulse Width, Semi,",
            "Tune, Voice Mode",
            "(Single / Layer),",
            "Timbre Balance,",
            "Mod Wheel (as CC1)."
          ]
        },
        {
          "title": "3: Envelopes",
          "lines": [
            "Filter EG: Attack,",
            "Decay, Sustain,",
            "Release.",
            "Amp EG: Decay,",
            "Sustain.",
            "Key Track, EG Int."
          ]
        },
        {
          "title": "4: Mix/Filter",
          "lines": [
            "Osc Mix, Noise,",
            "Sync / Ring,",
            "Filter Type (LPF24,",
            "LPF12, BPF12, HPF12),",
            "Drive, Level,",
            "Portamento."
          ]
        },
        {
          "title": "5: Effects",
          "lines": [
            "Chorus mix,",
            "Delay Time, Feedback,",
            "Delay mix,",
            "Master Vol, Pan,",
            "LFO 1 & 2 rates."
          ]
        },
        {
          "title": "6: Arp Settings",
          "lines": [
            "Type: UP, DOWN, ALT1,",
            "ALT2, RANDOM, TRIGGER",
            "Range 1-4 octaves,",
            "Resolution 1/24-1/4,",
            "Gate, Swing, Latch,",
            "Key Sync, Target",
            "timbre (Layer mode)."
          ]
        },
        {
          "title": "7: Arp Steps",
          "lines": [
            "8 knobs = 8 steps:",
            "top row 1-4,",
            "bottom row 5-8.",
            "Hollow box: rest",
            "Filled box: play",
            "Inverted: sounding",
            "Dotted: past the",
            "pattern length."
          ]
        },
        {
          "title": "8: Bank",
          "lines": [
            "Built-in bank or a",
            ".syx file in banks/.",
            "Browse banks lists",
            "them. Changing bank",
            "keeps the program."
          ]
        }
      ]
    },
    {
      "title": "Arpeggiator",
      "lines": [
        "Each program plays",
        "its own arpeggio,",
        "on or off as stored.",
        "Arp on Perf turns it",
        "on / off until the",
        "next program. Edits",
        "are saved with the",
        "slot."
      ]
    },
    {
      "title": "Layer Mode",
      "lines": [
        "Timbre Edit (Perf)",
        "picks the timbre the",
        "per-timbre knobs edit",
        "on Perf, Osc/Timbre,",
        "Envelopes and",
        "Mix/Filter: [T1] or",
        "[T2] in the header,",
        "labels T1.CUT/T2.CUT.",
        "In Single mode there",
        "is one timbre: Timbre",
        "Edit reads N/A."
      ]
    }
  ]
}
