{
  "title": "TinyK",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "microKORG-style",
        "virtual analog synth.",
        "4 voices, or two",
        "layers (L1 / L2).",
        "",
        "128 built-in programs",
        "or your own microKORG",
        "/ MS2000 .syx banks.",
        "",
        "Jog: browse programs.",
        "Shift+Click: jump to",
        "any page."
      ]
    },
    {
      "title": "Pages",
      "children": [
        {
          "title": "1: Perf",
          "lines": [
            "Enc 1 CAT: category",
            "Enc 2 PROG: program",
            "Enc 3 ARP: on / off",
            "Enc 4 MODE: Single /",
            "  Layer",
            "Enc 5 CUT: cutoff",
            "Enc 6 RES: resonance",
            "Enc 7 REL: amp release",
            "Enc 8 LAYER: L1 / L2",
            "  (N/A in Single)"
          ]
        },
        {
          "title": "2: Osc",
          "lines": [
            "Wave 1, Wave 2,",
            "Pulse Width, Semi,",
            "Tune, Voice (Mono /",
            "Poly / Unison),",
            "Layer Bal, Mod Wheel.",
            "Header shows [L1] or",
            "[L2]."
          ]
        },
        {
          "title": "3: Envelopes",
          "lines": [
            "Filter EG: Attack,",
            "Decay, Sustain,",
            "Release.",
            "Amp EG: Decay,",
            "Sustain.",
            "Key Track, EG Int.",
            "Header shows [L1] or",
            "[L2]."
          ]
        },
        {
          "title": "4: Mix/Filter",
          "lines": [
            "Osc Mix, Noise,",
            "Sync / Ring,",
            "Filter Type (LPF24,",
            "LPF12, BPF12, HPF12),",
            "Drive, Level,",
            "Portamento, Amp Atk.",
            "Header shows [L1] or",
            "[L2]."
          ]
        },
        {
          "title": "5: Effects",
          "lines": [
            "Chorus mix,",
            "Delay Time, Feedback,",
            "Delay mix,",
            "Master Vol, Pan,",
            "LFO 1 & 2 rates."
          ]
        },
        {
          "title": "6: Arp Settings",
          "lines": [
            "Type: UP, DOWN, ALT1,",
            "ALT2, RANDOM, TRIGGER",
            "Range 1-4 octaves,",
            "Resolution 1/24-1/4,",
            "Gate, Swing, Latch,",
            "Key Sync, Target",
            "layer (Layer mode)."
          ]
        },
        {
          "title": "7: Arp Steps",
          "lines": [
            "8 knobs = 8 steps:",
            "top row 1-4,",
            "bottom row 5-8.",
            "Hollow box: rest",
            "Filled box: play",
            "Inverted: sounding",
            "Dotted: past the",
            "pattern length."
          ]
        },
        {
          "title": "8: Bank",
          "lines": [
            "Built-in bank or a",
            ".syx file in banks/.",
            "Browse banks lists",
            "them. Changing bank",
            "keeps the program."
          ]
        }
      ]
    },
    {
      "title": "Arpeggiator",
      "lines": [
        "Each program plays",
        "its own arpeggio,",
        "on or off as stored.",
        "Arp on Perf turns it",
        "on / off until the",
        "next program. Edits",
        "are saved with the",
        "slot."
      ]
    },
    {
      "title": "Layer Mode",
      "lines": [
        "Mode (Perf) picks",
        "Single (one layer, 4",
        "voices) or Layer (two",
        "layers, 2 voices each).",
        "Layer (Perf) picks the",
        "layer the per-layer",
        "knobs edit: L1 or L2",
        "in the header of Osc,",
        "Envelopes, Mix/Filter;",
        "labels L1.CUT/L2.CUT.",
        "In Single mode Layer",
        "reads N/A.",
        "Voice = Mono, Poly or",
        "Unison (Osc page)."
      ]
    }
  ]
}
