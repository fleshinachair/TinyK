{
  "title": "TinyK",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "microKORG-style",
        "virtual analog synth.",
        "8 voices, or two",
        "layers (L1 / L2).",
        "",
        "112 built-in programs",
        "or your own microKORG",
        "/ MS2000 .syx banks.",
        "",
        "Jog: browse programs.",
        "Shift+Click: jump to",
        "any page."
      ]
    },
    {
      "title": "Pages",
      "children": [
        {
          "title": "1: Perf",
          "lines": [
            "Enc 1 CAT: category",
            "Enc 2 PROG: program",
            "Enc 3 ARP: on / off",
            "Enc 4 MODE: Single /",
            "  Layer",
            "Enc 5 LAYER: L1 / L2",
            "  (N/A in Single)",
            "Enc 6 VOICE: Mono /",
            "  Poly / Unison",
            "Enc 7 PORTA: glide",
            "Enc 8 BAL: layer",
            "  balance"
          ]
        },
        {
          "title": "2: Osc",
          "lines": [
            "Wave 1, Control 1,",
            "Control 2, Wave 2,",
            "Sync / Ring, Semi,",
            "Tune, Osc Mix.",
            "Header shows [L1] or",
            "[L2].",
            "",
            "Control 1 / 2 depend",
            "on Wave 1: pulse",
            "width, Vox formant,",
            "Noise cutoff / res,",
            "sine cross-mod.",
            "",
            "Wave 1 = DWGS: knob 2",
            "picks one of the 64",
            "DWGS waves, shown by",
            "number and name."
          ]
        },
        {
          "title": "3: Filter",
          "lines": [
            "Type (LPF24, LPF12,",
            "BPF12, HPF12),",
            "Cutoff, Resonance,",
            "EG Int.",
            "Filter EG: Attack,",
            "Decay, Sustain,",
            "Release.",
            "Header shows [L1] or",
            "[L2]."
          ]
        },
        {
          "title": "4: Amp",
          "lines": [
            "Noise, Level,",
            "Distortion (on /",
            "off), Pan.",
            "Amp EG: Attack,",
            "Decay, Sustain,",
            "Release.",
            "Header shows [L1] or",
            "[L2]."
          ]
        },
        {
          "title": "5: Mod",
          "lines": [
            "LFO 1 & 2 rates,",
            "Mod Wheel,",
            "Filter Key Track."
          ]
        },
        {
          "title": "6: Effects",
          "lines": [
            "Mod FX: Type (Chorus",
            "/ Flanger, Ensemble,",
            "Phaser), Speed,",
            "Depth.",
            "Delay: Type (Stereo,",
            "Cross, L/R), Time,",
            "Feedback, Mix.",
            "Master Vol."
          ]
        },
        {
          "title": "7: Arp Settings",
          "lines": [
            "Type: UP, DOWN, ALT1,",
            "ALT2, RANDOM, TRIGGER",
            "Range 1-4 octaves,",
            "Resolution 1/24-1/4,",
            "Gate, Swing, Latch,",
            "Key Sync, Target",
            "layer (Layer mode)."
          ]
        },
        {
          "title": "8: Arp Steps",
          "lines": [
            "8 knobs = 8 steps:",
            "top row 1-4,",
            "bottom row 5-8.",
            "Hollow box: rest",
            "Filled box: play",
            "Inverted: sounding",
            "Dotted: past the",
            "pattern length."
          ]
        },
        {
          "title": "9: Bank",
          "lines": [
            "Built-in bank or a",
            ".syx file in banks/.",
            "Browse banks lists",
            "them. Changing bank",
            "keeps the program."
          ]
        }
      ]
    },
    {
      "title": "Arpeggiator",
      "lines": [
        "Each program plays",
        "its own arpeggio,",
        "on or off as stored.",
        "Arp on Perf turns it",
        "on / off until the",
        "next program. Edits",
        "are saved with the",
        "slot."
      ]
    },
    {
      "title": "Layer Mode",
      "lines": [
        "Mode (Perf) picks",
        "Single (one layer, 4",
        "voices) or Layer (two",
        "layers, 4 voices each).",
        "Layer (Perf) picks the",
        "layer the per-layer",
        "knobs edit: L1 or L2",
        "in the header of Osc,",
        "Filter and Amp;",
        "labels L1.CUT/L2.CUT.",
        "In Single mode Layer",
        "reads N/A.",
        "Voice = Mono, Poly or",
        "Unison (Osc page)."
      ]
    }
  ]
}
