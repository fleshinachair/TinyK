build/
build-*/
dist/
*.o
*.a
*.tar.gz
.DS_Store

# transient build/tool output
*.log
__pycache__/
.serena/
.toolchain/

# SysEx banks and programs are local inputs: presets.h is generated from them and committed, so the
# module builds and plays with no .syx present
*.syx
banks/*.syx
# user bank drop folder: contents never tracked, the folder itself is (via .gitkeep)
banks/*
!banks/.gitkeep

